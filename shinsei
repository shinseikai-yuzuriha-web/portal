          '<button class="small" data-ed="tup" data-i="' + i + '"' + (i === 0 ? ' disabled' : '') + ' aria-label="上へ">↑</button>' +
          '<button class="small" data-ed="tdown" data-i="' + i + '"' + (i === types.length - 1 ? ' disabled' : '') + ' aria-label="下へ">↓</button>' +
          '<button class="small" data-ed="toggle" data-i="' + i + '">' + (t.show ? '表示しない' : '表示する') + '</button>' +
          '<button class="small" data-ed="edit" data-i="' + i + '">項目を編集</button></div></div>';
      }).join('') : '<p class="hint">申請の種類がありません。</p>') +
      '</div><button data-ed="tadd">＋ 新しい申請の種類</button>' +
      '<h3>どの申請にも付く項目</h3><div class="sh-box"><div class="sh-pair">' +
        '<div><label for="shEdDeptLabel">1つ目の項目名</label><input type="text" id="shEdDeptLabel" data-c="dept.label" value="' + esc(deptField().label) + '"></div>' +
        '<div><label for="shEdDeptPh">入力例</label><input type="text" id="shEdDeptPh" data-c="dept.ph" value="' + esc(deptField().ph || '') + '"></div></div>' +
        '<label for="shEdJobLabel">2つ目の項目名</label><input type="text" id="shEdJobLabel" data-c="job.label" value="' + esc(jobField().label) + '">' +
        '<label for="shEdJobOpts">' + esc(jobField().label) + 'の選択肢（1行に1つ）</label><textarea id="shEdJobOpts" data-c="job.opts" rows="6">' + esc(jobField().opts.join('\n')) + '</textarea>' +
      '</div>' + saveBar();
  }
  function renderTypeEditor() {
    var t = edType();
    var dates = t.fields.filter(function (f) { return f.type === 'date'; });
    var rangeOpts = function (sel) {
      return '<option value="">（なし）</option>' + dates.map(function (f) { return '<option value="' + esc(f.k) + '"' + (f.k === sel ? ' selected' : '') + '>' + esc(f.label) + '</option>'; }).join('');
    };
    var r = t.range || ['', ''];
    var catsMode = !!(t.cats && t.cats.length) || S.audOpen === t.id;
    $('shEd').innerHTML =
      '<div class="row"><button class="small" data-ed="back">← 一覧に戻る</button><span class="hint">一覧に戻っても変更は残ります。最後に「保存して全員に反映」を押してください。</span></div>' +
      '<h3>申請の種類</h3><div class="sh-box"><div class="sh-pair">' +
        '<div><label for="shEdTLabel">名前</label><input type="text" id="shEdTLabel" data-t="label" maxlength="30" value="' + esc(t.label) + '"></div>' +
        '<div><label for="shEdTCh">一覧に出す一文字</label><input type="text" id="shEdTCh" data-t="ch" maxlength="1" value="' + esc(t.ch) + '"></div></div>' +
        '<label for="shEdTDesc">説明（選ぶ画面に出る一言）</label><input type="text" id="shEdTDesc" data-t="desc" maxlength="80" value="' + esc(t.desc || '') + '">' +
        '<div class="sh-checks"><label><input type="checkbox" data-t="show"' + (t.show ? ' checked' : '') + '> 職員の画面に表示する</label></div>' +
      '</div>' +
      '<h3>表示する人</h3><div class="sh-box">' +
        '<div class="sh-checks"><label><input type="radio" name="shAud" data-aud="all"' + (catsMode ? '' : ' checked') + '> 全員</label>' +
        '<label><input type="radio" name="shAud" data-aud="cats"' + (catsMode ? ' checked' : '') + '> 選んだカテゴリの人だけ</label></div>' +
        (catsMode
          ? (S.cats.length ? '<div class="sh-checks" style="margin-top:8px">' + S.cats.map(function (c) {
              return '<label><input type="checkbox" data-tc="' + esc(c.id) + '"' + ((t.cats || []).indexOf(c.id) >= 0 ? ' checked' : '') + '> ' + esc(c.name) + '</label>'; }).join('') + '</div>'
            : '<p class="sh-note" style="margin:8px 0 0">カテゴリがまだありません。</p>') +
            '<p class="sh-err' + (t.cats && t.cats.length ? ' hidden' : '') + '" id="shAudWarn" style="margin-top:6px">カテゴリを1つ以上選んでください。選ばないまま保存すると全員に表示されます。</p>' +
            '<p class="hint" style="margin:8px 0 0">カテゴリは上の「管理」→「カテゴリ」で作り、「ユーザー」で職員に付けます（例：「医師」カテゴリを作って医師に付ける）。資料フォルダは設定しなくてもかまいません。管理者（理事長・事務長）には、ここの設定にかかわらず全部表示されます。</p>'
          : '') +
      '</div>' +
      '<h3>項目</h3>' + t.fields.map(function (f, i) {
        return '<div class="sh-field"><div class="sh-frow"><div><label for="shEdF' + i + 'L">項目名</label><input type="text" id="shEdF' + i + 'L" data-fi="' + i + '" data-p="label" maxlength="40" value="' + esc(f.label) + '"></div>' +
          '<div><label for="shEdF' + i + 'T">入力の形</label><select id="shEdF' + i + 'T" data-fi="' + i + '" data-p="type">' + Object.keys(KINDS).map(function (k) {
            return '<option value="' + k + '"' + (k === f.type ? ' selected' : '') + '>' + KINDS[k] + '</option>'; }).join('') + '</select></div></div>' +
          (f.type === 'select' ? '<label for="shEdF' + i + 'O">選択肢（1行に1つ）</label><textarea id="shEdF' + i + 'O" data-fi="' + i + '" data-p="opts" rows="4">' + esc((f.opts || []).join('\n')) + '</textarea>' : '') +
          (f.type === 'date' || f.type === 'select' ? '' : '<label for="shEdF' + i + 'P">入力例（薄い字で出る）</label><input type="text" id="shEdF' + i + 'P" data-fi="' + i + '" data-p="ph" maxlength="80" value="' + esc(f.ph || '') + '">') +
          '<div class="sh-checks"><label><input type="checkbox" data-fi="' + i + '" data-p="req"' + (f.req ? ' checked' : '') + '> 必須</label>' +
          '<label><input type="checkbox" data-fi="' + i + '" data-p="wide"' + (f.wide ? ' checked' : '') + '> 横いっぱいに広げる</label>' +
          '<span class="spacer"></span><span class="sh-btns">' +
          '<button class="small" data-ed="fup" data-i="' + i + '"' + (i === 0 ? ' disabled' : '') + ' aria-label="上へ">↑</button>' +
          '<button class="small" data-ed="fdown" data-i="' + i + '"' + (i === t.fields.length - 1 ? ' disabled' : '') + ' aria-label="下へ">↓</button>' +
          '<button class="small danger" data-ed="fdel" data-i="' + i + '">削除</button></span></div></div>';
      }).join('') +
      '<button data-ed="fadd">＋ 項目を追加</button>' +
      '<h3>期間のチェック（任意）</h3><div class="sh-box"><p class="hint" style="margin:0">日付の項目を2つ選ぶと、日数を自動で表示し、終わりが始まりより前なら止めます。</p><div class="sh-pair">' +
        '<div><label for="shEdR0">始まりの日付</label><select id="shEdR0" data-r="0">' + rangeOpts(r[0]) + '</select></div>' +
        '<div><label for="shEdR1">終わりの日付</label><select id="shEdR1" data-r="1">' + rangeOpts(r[1]) + '</select></div></div></div>' +
      '<div class="row" style="margin-top:16px"><span class="hint">使わないだけなら「職員の画面に表示する」を外せば隠せます。</span><span class="spacer"></span>' +
      '<button class="small danger" data-ed="tdel">この申請の種類を削除</button></div>' +
      saveBar();
  }
  function catNames(ids) {
    return (ids || []).map(function (id) { var c = S.cats.filter(function (x) { return x.id === id; })[0]; return c ? c.name : id; }).join('・');
  }
  function move(arr, i, d) { var j = i + d; if (j < 0 || j >= arr.length) return; var x = arr[i]; arr[i] = arr[j]; arr[j] = x; }

  // 入力欄の変更（文字・チェック・選択）
  $('shEd').addEventListener('input', function (e) { edInput(e.target, false); });
  $('shEd').addEventListener('change', function (e) { edInput(e.target, true); });
  function edInput(el, isChange) {
    if (!S.forms) return;
    var c = el.getAttribute('data-c'), tp = el.getAttribute('data-t'), fi = el.getAttribute('data-fi'), rr = el.getAttribute('data-r');
    if (c) {
      var parts = c.split('.'), f = parts[0] === 'job' ? jobField() : deptField();
      f[parts[1]] = parts[1] === 'opts' ? el.value.split('\n') : el.value;
      dirty(); return;
    }
    var t = edType(); if (!t) return;
    var aud = el.getAttribute('data-aud'), tc = el.getAttribute('data-tc');
    if (aud && isChange) {
      if (aud === 'all') { t.cats = []; S.audOpen = null; } else { S.audOpen = t.id; }
      dirty(); renderTypeEditor(); return;
    }
    if (tc && isChange) {
      var cs = (t.cats || []).filter(function (x) { return x !== tc; });
      if (el.checked) cs.push(tc);
      t.cats = cs; dirty();
      if ($('shAudWarn')) $('shAudWarn').classList.toggle('hidden', cs.length > 0);
      return;
    }
    if (aud || tc) return;
    if (tp) { t[tp] = el.type === 'checkbox' ? el.checked : el.value; dirty(); return; }
    if (rr !== null) { var rg = t.range ? t.range.slice() : ['', '']; rg[+rr] = el.value; t.range = rg[0] || rg[1] ? rg : null; dirty(); return; }
    if (fi !== null) {
      var fld = t.fields[+fi], p = el.getAttribute('data-p');
      if (el.type === 'checkbox') fld[p] = el.checked;
      else if (p === 'opts') fld.opts = el.value.split('\n');
      else fld[p] = el.value;
      dirty();
      if (p === 'type' && isChange) {
        if (fld.type === 'select' && !(fld.opts && fld.opts.filter(String).length)) fld.opts = ['選択肢1', '選択肢2'];
        if (t.range && t.range.indexOf(fld.k) >= 0 && fld.type !== 'date') t.range = null;
        renderTypeEditor();
      }
    }
  }
  // ボタン
  $('shEd').addEventListener('click', function (e) {
    var b = e.target.closest('[data-ed]');
    if (!b || !S.forms) return;
    var a = b.getAttribute('data-ed'), i = +b.getAttribute('data-i'), types = S.forms.types, t = edType();
    switch (a) {
      case 'tup': move(types, i, -1); dirty(); renderEditor(); break;
      case 'tdown': move(types, i, 1); dirty(); renderEditor(); break;
      case 'toggle': types[i].show = !types[i].show; dirty(); renderEditor(); break;
      case 'edit': S.editId = types[i].id; renderEditor(); window.scrollTo(0, 0); break;
      case 'tdel':
        confirmBox('申請の種類を削除', '「' + t.label + '」を様式から削除します（「保存して全員に反映」を押すまでは確定しません）。提出済みの申請は残ります。', function () {
          S.forms.types = types.filter(function (x) { return x !== t; }); S.editId = null; dirty(); renderEditor(); window.scrollTo(0, 0);
        });
        break;
      case 'tadd':
        var nt = { id: newKey('t'), label: '新しい申請', ch: '新', desc: '', show: false, range: null,
          fields: [{ k: newKey('f'), label: '件名', type: 'text', req: true, wide: true, ph: '' }] };
        types.push(nt); S.editId = nt.id; dirty(); renderEditor(); window.scrollTo(0, 0);
        break;
      case 'back': S.editId = null; renderEditor(); window.scrollTo(0, 0); break;
      case 'fup': move(t.fields, i, -1); dirty(); renderTypeEditor(); break;
      case 'fdown': move(t.fields, i, 1); dirty(); renderTypeEditor(); break;
      case 'fdel':
        var fk = t.fields[i].k;
        t.fields.splice(i, 1);
        if (t.range && t.range.indexOf(fk) >= 0) t.range = null;
        dirty(); renderTypeEditor();
        break;
      case 'fadd': t.fields.push({ k: newKey('f'), label: '', type: 'text', req: false, wide: false, ph: '' }); dirty(); renderTypeEditor();
        var last = document.querySelectorAll('#shEd .sh-field input[data-p="label"]'); if (last.length) last[last.length - 1].focus();
        break;
      case 'revert':
        confirmBox('変更を取り消す', '保存していない変更をすべて取り消して、保存済みの様式に戻します。', function () { loadForms(); });
        break;
      case 'save':
        b.disabled = true; b.textContent = '保存中…';
        run('apiShinseiSaveForms', [state.token, S.forms], function (res) {
          S.forms = res.forms; S.cats = res.categories || S.cats; S.formsDirty = false;
          if (S.editId && !edType()) S.editId = null;
          renderTabs(); renderEditor();
          setMsg('shFormsMsg', '保存しました。職員が申請画面を開き直すと反映されます。', 'info');
          load(true);
        }, function (m) {
          b.disabled = false; b.textContent = '保存して全員に反映';
          setMsg('shFormsMsg', m);
        });
        break;
    }
  });
})();
</script>

<!-- Supabase 版だけの調整：Googleドライブの資料表示は使わないので隠す。カテゴリは申請の振り分けに使う -->
<style>
  #view-home > .card:not(#shHomeCard):not(#tkHomeCard) { display: none; }
  #catDialog label[for=cFolder], #cFolder, #catDialog .hint { display: none; }
  #pane-cats th:nth-child(4), #pane-cats td:nth-child(4) { display: none; }
  #logRows td:last-child { min-width: 14em; }
</style>
<script>
  (function () {
    var hint = document.querySelector('#pane-cats .hint');
    if (hint) hint.textContent = 'カテゴリは、申請を出せる人の振り分けに使います（例：医師休暇申請は「医師」カテゴリの人だけ）。削除すると、全ユーザーからそのカテゴリが外れます。';
    if (/xxxxxxxx|ここに/.test(SUPABASE_URL + SUPABASE_ANON_KEY)) {
      setMsg('loginMsg', 'まだ Supabase につながっていません。index.html の最初にある SUPABASE_URL と SUPABASE_ANON_KEY を設定してください。');
    }
  })();
</script>

<!-- 申請だけ／タスクだけのシステムにする切り替え（build.py が shinsei と 真成会 申請・届出 を入れる） -->
<script>
  (function () {
    var APP = 'shinsei', TITLE = '真成会 申請・届出', NAME = '申請・届出';
    document.title = TITLE;
    $('appTitle').textContent = TITLE;
    // ログインの見出しは「真成会」と「〇〇ログイン」の2行
    var lt = $('loginTitle');
    lt.textContent = '';
    lt.appendChild(document.createTextNode('真成会'));
    lt.appendChild(document.createElement('br'));
    lt.appendChild(document.createTextNode(NAME + 'ログイン'));
    // 「ホーム」はこのシステムの画面そのものにする
    var prev = window.showView;
    window.showView = function (name) {
      if (name === 'home' && state.me && !state.me.mustChange) name = APP;
      prev(name);
    };
    var homeBtn = document.querySelector('#appHeader .row button');
    if (homeBtn && homeBtn.textContent.trim() === 'ホーム') homeBtn.classList.add('hidden');
  })();
</script>

