<script>
  // ===== ここに Supabase の2つを貼る（Project Settings → API） ===================
  var SUPABASE_URL = "https://lzkeaetpykhdrwwwspjy.supabase.co";          // Project URL
  var SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx6a2VhZXRweWtoZHJ3d3dzcGp5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQyNDM3MTgsImV4cCI6MjEwOTgxOTcxOH0.w_iThhR7s9ZF2R_Co3OIedwdQcsFGSb7WqX4TTTE0uM";      // anon public（または Publishable）キー
  // ※ service_role（Secret）キーは絶対に貼らないこと
  // ============================================================================

  // GAS の google.script.run と同じ書き方で、Supabase の api_ 関数を呼ぶ
  (function () {
    function snake(n) { return n.replace(/[A-Z]/g, function (c) { return '_' + c.toLowerCase(); }); }
    function baseUrl() {
      // 余分な空白や、うっかり付けた /rest/v1 などを取り除く
      return String(SUPABASE_URL).trim().replace(/\/+$/, '').replace(/\/(rest|auth)\/v1.*$/, '');
    }
    /** つながらなかった理由を、画面に出せる言葉にする */
    function explain(status, body, fnName) {
      var b = body || {};
      var code = b.code || '', msg = String(b.message || b.msg || b.error || '');
      var head = '接続エラー（' + (status ? 'HTTP ' + status : 'ネットワーク') + (code ? '・' + code : '') + '）：';
      if (!status) return head + 'Supabase に届きませんでした。SUPABASE_URL が「https://〇〇〇.supabase.co」の形か、インターネットにつながっているか確認してください。';
      if (status === 401 || /api ?key|jwt|secret/i.test(msg)) {
        if (/secret/i.test(msg)) return head + 'Secret キーが貼られています。anon public（または Publishable）キーに替えてください。';
        return head + 'キーが受け付けられませんでした。SUPABASE_ANON_KEY に anon public（または Publishable）キーを、前後の空白なしで貼り直してください。';
      }
      if (code === 'PGRST202' || (status === 404 && /function|schema cache/i.test(msg))) {
        return head + '関数「' + fnName + '」が見つかりません。SQL Editor（上の選択欄がデータベースになっていること）で portal.sql をもう一度「Run」してください。';
      }
      if (status === 404) return head + 'つなぎ先が見つかりません。SUPABASE_URL の打ち間違い、または Project Settings → Data API が「有効」になっているか確認してください。';
      if (code === '42501' || status === 403) return head + '関数を呼ぶ許可がありません。portal.sql をもう一度「Run」してください。';
      return head + (msg || '原因がわかりませんでした') ;
    }
    function runner(ok, ng) {
      return new Proxy({}, {
        get: function (_, k) {
          if (k === 'withSuccessHandler') return function (f) { return runner(f, ng); };
          if (k === 'withFailureHandler') return function (f) { return runner(ok, f); };
          return function () {
            var args = Array.prototype.slice.call(arguments);
            var fnName = snake(String(k));
            var key = String(SUPABASE_ANON_KEY).trim();
            var headers = { 'apikey': key, 'Content-Type': 'application/json' };
            if (/^eyJ/.test(key)) headers.Authorization = 'Bearer ' + key;
            var fail = function (status, body) {
              var m = explain(status, body, fnName);
              console.error(m, body);
              // 画面に理由を出す（ログイン画面などのメッセージ欄に表示される）
              if (ok) ok({ ok: false, message: m }); else if (ng) ng(new Error(m));
            };
            fetch(baseUrl() + '/rest/v1/rpc/' + fnName, {
              method: 'POST', headers: headers, body: JSON.stringify({ a: args })
            }).then(function (r) {
              return r.text().then(function (t) {
                var j = null; try { j = JSON.parse(t); } catch (e) { j = { message: t }; }
                if (!r.ok) { fail(r.status, j); return; }
                if (ok) ok(j);
              });
            }, function () { fail(0, null); });
          };
        }
      });
    }
    window.google = { script: { run: runner(null, null) } };
  })();
</script>

