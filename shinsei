<body>
<div id="loading"></div>

<header id="appHeader" class="hidden">
  <h1 id="appTitle"></h1>
  <div class="row">
    <span class="who" id="whoami"></span>
    <button class="small" onclick="showView('home')">ホーム</button>
    <button class="small hidden" id="adminBtn" onclick="openAdmin()">管理</button>
    <button class="small" onclick="showView('changePw')">PW変更</button>
    <button class="small" onclick="logout()">ログアウト</button>
  </div>
</header>

<main>
  <!-- ログイン -->
  <section id="view-login" class="card narrow">
    <h2 id="loginTitle"></h2>
    <form onsubmit="login(event)">
      <label for="loginId">ID</label>
      <input type="text" id="loginId" autocomplete="username" autocapitalize="off">
      <label for="loginPw">パスワード</label>
      <input type="password" id="loginPw" autocomplete="current-password">
      <button class="primary full" type="submit">ログイン</button>
    </form>
    <div class="msg" id="loginMsg"></div>
  </section>

  <!-- PW変更 -->
  <section id="view-changePw" class="card narrow hidden">
    <h2>パスワード変更</h2>
    <p class="hint" id="mustChangeNote">初回ログインのため、パスワードを変更してください。</p>
    <form onsubmit="changePw(event)">
      <label for="oldPw">今のパスワード</label>
      <input type="password" id="oldPw" autocomplete="current-password">
      <label for="newPw">新しいパスワード（8文字以上・英字と数字を含む）</label>
      <input type="password" id="newPw" autocomplete="new-password">
      <label for="newPw2">新しいパスワード（確認）</label>
      <input type="password" id="newPw2" autocomplete="new-password">
      <button class="primary full" type="submit">変更する</button>
    </form>
    <div class="msg" id="pwMsg"></div>
  </section>

  <!-- ホーム -->
  <section id="view-home" class="hidden">
    <div class="card">
      <h2>使えるカテゴリ</h2>
      <div class="grid" id="myCats"></div>
      <p class="hint" id="noCats"></p>
    </div>
  </section>

  <!-- ファイル一覧 -->
  <section id="view-files" class="hidden">
    <div class="card">
      <div class="crumbs" id="crumbs"></div>
      <ul class="flist" id="fileList"></ul>
      <p class="hint" id="filesEmpty"></p>
      <p class="hint">見るだけの画面です。ファイルの追加・変更は管理者が行います。</p>
    </div>
  </section>

  <!-- 管理 -->
  <section id="view-admin" class="hidden">
    <div class="card">
      <div class="tabs">
        <button id="tab-users" class="active" onclick="adminTab('users')">ユーザー</button>
        <button id="tab-cats" onclick="adminTab('cats')">カテゴリ</button>
        <button id="tab-log" onclick="adminTab('log')">操作ログ</button>
      </div>

      <div id="pane-users">
        <div class="row" style="margin-bottom:8px">
          <input type="text" id="userFilter" placeholder="ID・氏名で絞り込み" oninput="renderUsers()" style="max-width:240px">
          <span class="spacer"></span>
          <button class="primary" onclick="openUserDialog(null)">＋ ユーザー追加</button>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>ID</th><th>氏名</th><th>役割</th><th>カテゴリ</th><th>状態</th><th>最終ログイン</th><th></th></tr></thead>
          <tbody id="userRows"></tbody>
        </table></div>
      </div>

      <div id="pane-cats" class="hidden">
        <div class="row" style="margin-bottom:8px">
          <span class="hint">カテゴリ名はいつでも変えられます。削除すると、全ユーザーからそのカテゴリが外れます。</span>
          <span class="spacer"></span>
          <button class="primary" onclick="openCatDialog(null)">＋ カテゴリ追加</button>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>ID</th><th>名前</th><th>説明</th><th>フォルダ</th><th>人数</th><th></th></tr></thead>
          <tbody id="catRows"></tbody>
        </table></div>
      </div>

      <div id="pane-log" class="hidden">
        <p class="hint">新しい順に最大200件</p>
        <div class="tablewrap"><table>
          <thead><tr><th>日時</th><th>操作者</th><th>操作</th><th>対象</th><th>詳細</th></tr></thead>
          <tbody id="logRows"></tbody>
        </table></div>
      </div>
    </div>
  </section>
</main>

<!-- ユーザー編集 -->
<div class="overlay" id="userDialog">
  <div class="dialog">
    <h2 id="userDialogTitle"></h2>
    <label for="uId">ID（半角英数字3〜30文字・後から変更不可）</label>
    <input type="text" id="uId" autocapitalize="off">
    <label for="uName">氏名</label>
    <input type="text" id="uName">
    <label>役割</label>
    <div class="radio">
      <label><input type="radio" name="uRole" value="一般" checked> 一般</label>
      <label><input type="radio" name="uRole" value="管理者"> 管理者（理事長・事務長）</label>
    </div>
    <label>カテゴリ（複数選べます）</label>
    <div class="checks" id="uCats"></div>
    <div class="msg" id="userMsg"></div>
    <div class="row" style="margin-top:16px">
      <button onclick="closeDialog('userDialog')">キャンセル</button>
      <span class="spacer"></span>
      <button class="primary" onclick="saveUser()">保存</button>
    </div>
  </div>
</div>

<!-- カテゴリ編集 -->
<div class="overlay" id="catDialog">
  <div class="dialog">
    <h2 id="catDialogTitle"></h2>
    <label for="cName">カテゴリ名</label>
    <input type="text" id="cName">
    <label for="cDesc">説明（任意）</label>
    <input type="text" id="cDesc">
    <label for="cFolder">ドライブのフォルダ（URLを貼り付け・任意）</label>
    <input type="text" id="cFolder" placeholder="https://drive.google.com/drive/folders/...">
    <p class="hint">フォルダは「システム管理用アカウント」に共有しておいてください。このカテゴリの人は、中身を見るだけできます。</p>
    <div class="msg" id="catMsg"></div>
    <div class="row" style="margin-top:16px">
      <button onclick="closeDialog('catDialog')">キャンセル</button>
      <span class="spacer"></span>
      <button class="primary" onclick="saveCat()">保存</button>
    </div>
  </div>
</div>

<!-- 初期PW表示 -->
<div class="overlay" id="pwDialog">
  <div class="dialog">
    <h2>初期パスワード</h2>
    <p id="pwDialogFor"></p>
    <div class="pwbox" id="pwDialogValue"></div>
    <p class="hint">この画面を閉じると二度と表示されません。本人に直接渡してください。本人は初回ログイン時に変更します。</p>
    <button class="primary full" onclick="closeDialog('pwDialog')">控えたので閉じる</button>
  </div>
</div>

<!-- ファイル表示 -->
<div class="overlay" id="viewerDialog">
  <div class="dialog viewer">
    <div class="row">
      <b id="viewerName" style="overflow-wrap:anywhere"></b>
      <span class="spacer"></span>
      <a id="viewerDownload" download><button class="small">ダウンロード</button></a>
      <button class="small" onclick="closeViewer()">閉じる</button>
    </div>
    <div class="body" id="viewerBody"></div>
  </div>
</div>

<!-- 確認 -->
<div class="overlay" id="confirmDialog">
  <div class="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmText"></p>
    <div class="row" style="margin-top:16px">
      <button id="confirmCancel" onclick="closeDialog('confirmDialog')">やめる</button>
      <span class="spacer"></span>
      <button class="danger" id="confirmOk">実行する</button>
    </div>
  </div>
</div>

<script>
  var APP_NAME = "真成会ポータル";
  var ROLE_ADMIN = '管理者';
  var state = { token: null, me: null, users: [], cats: [], editingUser: null, editingCat: null };

  document.getElementById('appTitle').textContent = APP_NAME;
  document.getElementById('loginTitle').textContent = APP_NAME + ' ログイン';

  // ---- 共通 ----
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function $(id) { return document.getElementById(id); }
  function setMsg(id, text, kind) { var el = $(id); el.textContent = text || ''; el.className = 'msg ' + (text ? (kind || 'error') : ''); }

  /** サーバー関数を呼ぶ。失敗時の共通処理つき */
  function call(fn, args, onOk, msgId) {
    $('loading').style.display = 'block';
    var runner = google.script.run
      .withSuccessHandler(function (res) {
        $('loading').style.display = 'none';
        if (res && res.ok) { onOk(res); return; }
        var m = (res && res.message) || 'エラーが発生しました';
        if (res && res.relogin) { resetToLogin(m); return; }
        if (msgId) setMsg(msgId, m); else alertBox(m);
      })
      .withFailureHandler(function (err) {
        $('loading').style.display = 'none';
        var m = '通信エラーが発生しました。もう一度お試しください。';
        if (msgId) setMsg(msgId, m); else alertBox(m);
        console.error(err);
      });
    runner[fn].apply(runner, args);
  }

  function alertBox(text) {
    $('confirmTitle').textContent = 'お知らせ';
    $('confirmText').textContent = text;
    $('confirmOk').classList.add('hidden');
    $('confirmCancel').textContent = '閉じる';
    $('confirmDialog').classList.add('show');
  }
  function confirmBox(title, text, onOk) {
    $('confirmTitle').textContent = title;
    $('confirmText').textContent = text;
    var ok = $('confirmOk');
    ok.classList.remove('hidden');
    $('confirmCancel').textContent = 'やめる';
    ok.onclick = function () { closeDialog('confirmDialog'); onOk(); };
    $('confirmDialog').classList.add('show');
  }
  function closeDialog(id) { $(id).classList.remove('show'); }

  function showView(name) {
    if (!state.me) name = 'login';
    if (state.me && state.me.mustChange) name = 'changePw';
    ['login', 'changePw', 'home', 'files', 'admin'].forEach(function (v) { $('view-' + v).classList.toggle('hidden', v !== name); });
    $('appHeader').classList.toggle('hidden', !state.me);
    if (name === 'changePw') {
      $('mustChangeNote').classList.toggle('hidden', !(state.me && state.me.mustChange));
      ['oldPw', 'newPw', 'newPw2'].forEach(function (i) { $(i).value = ''; });
      setMsg('pwMsg', '');
    }
    if (name === 'home') renderHome();
  }

  function resetToLogin(message) {
    state.token = null; state.me = null;
    document.querySelectorAll('.overlay').forEach(function (o) { o.classList.remove('show'); });
    showView('login');
    setMsg('loginMsg', message || '');
  }

  // ---- ログイン ----
  function login(e) {
    e.preventDefault();
    setMsg('loginMsg', '');
    call('apiLogin', [$('loginId').value, $('loginPw').value], function (res) {
      state.token = res.token;
      setMe(res.me);
      $('loginPw').value = '';
      showView('home');
    }, 'loginMsg');
  }

  function setMe(me) {
    state.me = me;
    $('whoami').textContent = me.name + '（' + me.role + '）';
    $('adminBtn').classList.toggle('hidden', me.role !== ROLE_ADMIN);
  }

  function logout() {
    var t = state.token;
    resetToLogin('ログアウトしました');
    $('loginMsg').className = 'msg info';
    if (t) google.script.run.apiLogout(t);
  }

  function changePw(e) {
    e.preventDefault();
    if ($('newPw').value !== $('newPw2').value) { setMsg('pwMsg', '新しいパスワードが一致しません'); return; }
    call('apiChangePassword', [state.token, $('oldPw').value, $('newPw').value], function () {
      call('apiMe', [state.token], function (res) {
        setMe(res.me);
        showView('home');
      });
    }, 'pwMsg');
  }

  // ---- ホーム ----
  function renderHome() {
    var cats = (state.me && state.me.categories) || [];
    $('myCats').innerHTML = cats.map(function (c) {
      return '<div class="cat' + (c.hasFolder ? ' link' : '') + '" data-cat="' + esc(c.id) + '"><b>' + esc(c.name) + '</b><span class="hint">' +
        esc(c.desc || (c.hasFolder ? 'クリックで資料を見る' : 'まだ資料フォルダが設定されていません')) + '</span></div>';
    }).join('');
    $('noCats').textContent = cats.length ? '' : 'まだカテゴリが割り当てられていません。管理者に連絡してください。';
  }

  // ---- 管理画面 ----
  function openAdmin() {
    showView('admin');
    adminTab('users');
    loadAdmin();
  }
  function loadAdmin(cb) {
    call('apiAdminData', [state.token], function (res) {
      state.users = res.users; state.cats = res.categories;
      renderUsers(); renderCats();
      if (cb) cb();
    });
  }
  function adminTab(name) {
    ['users', 'cats', 'log'].forEach(function (t) {
      $('tab-' + t).classList.toggle('active', t === name);
      $('pane-' + t).classList.toggle('hidden', t !== name);
    });
    if (name === 'log') loadLog();
  }
  function catName(id) {
    for (var i = 0; i < state.cats.length; i++) if (state.cats[i].id === id) return state.cats[i].name;
    return id;
  }

  function renderUsers() {
    var q = $('userFilter').value.trim().toLowerCase();
    var rows = state.users.filter(function (u) {
      return !q || u.id.toLowerCase().indexOf(q) >= 0 || u.name.toLowerCase().indexOf(q) >= 0;
    });
    $('userRows').innerHTML = rows.map(function (u) {
      var isMe = u.id === state.me.id;
      var stopped = u.status === '停止';
      var cats = u.role === ROLE_ADMIN ? '<span class="tag admin">すべて</span>'
        : (u.cats.length ? u.cats.map(function (c) { return '<span class="tag">' + esc(catName(c)) + '</span>'; }).join('') : '<span class="hint">なし</span>');
      return '<tr>' +
        '<td>' + esc(u.id) + '</td>' +
        '<td>' + esc(u.name) + (u.mustChange ? ' <span class="tag">初回PW未変更</span>' : '') + '</td>' +
        '<td>' + (u.role === ROLE_ADMIN ? '<span class="tag admin">管理者</span>' : '一般') + '</td>' +
        '<td style="white-space:normal">' + cats + '</td>' +
        '<td>' + (stopped ? '<span class="tag stopped">停止</span>' : '有効') + '</td>' +
        '<td>' + esc(u.lastLogin || '—') + '</td>' +
        '<td class="row">' +
          '<button class="small" data-act="edit" data-id="' + esc(u.id) + '">編集</button>' +
          '<button class="small" data-act="reset" data-id="' + esc(u.id) + '">PW再発行</button>' +
          (isMe ? '' : '<button class="small" data-act="' + (stopped ? 'resume' : 'stop') + '" data-id="' + esc(u.id) + '">' + (stopped ? '再開' : '停止') + '</button>' +
                       '<button class="small danger" data-act="delete" data-id="' + esc(u.id) + '">削除</button>') +
        '</td></tr>';
    }).join('') || '<tr><td colspan="7" class="hint">該当なし</td></tr>';
  }

  $('userRows').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-act]');
    if (!b) return;
    var u = state.users.filter(function (x) { return x.id === b.getAttribute('data-id'); })[0];
    if (!u) return;
    var act = b.getAttribute('data-act');
    if (act === 'edit') openUserDialog(u);
    if (act === 'reset') confirmBox('PW再発行', u.name + ' さんのパスワードを再発行します。今のパスワードは使えなくなります。', function () {
      call('apiResetPassword', [state.token, u.id], function (res) { showTempPw(u, res.tempPassword); loadAdmin(); });
    });
    if (act === 'stop') confirmBox('停止', u.name + ' さんを停止します。すぐにログインできなくなります（データは残ります）。', function () {
      call('apiSetStatus', [state.token, u.id, '停止'], function () { loadAdmin(); });
    });
    if (act === 'resume') call('apiSetStatus', [state.token, u.id, '有効'], function () { loadAdmin(); });
    if (act === 'delete') confirmBox('削除', u.name + '（' + u.id + '）を完全に削除します。元に戻せません。', function () {
      call('apiDeleteUser', [state.token, u.id], function () { loadAdmin(); });
    });
  });

  function openUserDialog(u) {
    state.editingUser = u;
    $('userDialogTitle').textContent = u ? 'ユーザー編集' : 'ユーザー追加';
    $('uId').value = u ? u.id : '';
    $('uId').disabled = !!u;
    $('uName').value = u ? u.name : '';
    var role = u ? u.role : '一般';
    document.querySelectorAll('input[name=uRole]').forEach(function (r) { r.checked = r.value === role; });
    $('uCats').innerHTML = state.cats.map(function (c) {
      var on = u && u.cats.indexOf(c.id) >= 0;
      return '<label><input type="checkbox" value="' + esc(c.id) + '"' + (on ? ' checked' : '') + '> ' + esc(c.name) + '</label>';
    }).join('') || '<span class="hint">カテゴリがありません</span>';
    setMsg('userMsg', '');
    $('userDialog').classList.add('show');
  }

  function saveUser() {
    var u = state.editingUser;
    var data = {
      id: $('uId').value.trim(),
      name: $('uName').value.trim(),
      role: document.querySelector('input[name=uRole]:checked').value,
      cats: Array.prototype.map.call(document.querySelectorAll('#uCats input:checked'), function (c) { return c.value; })
    };
    call('apiSaveUser', [state.token, data, !u], function (res) {
      closeDialog('userDialog');
      if (res.tempPassword) showTempPw(data, res.tempPassword);
      loadAdmin();
    }, 'userMsg');
  }

  function showTempPw(u, pw) {
    $('pwDialogFor').textContent = u.name + '（ID：' + u.id + '）';
    $('pwDialogValue').textContent = pw;
    $('pwDialog').classList.add('show');
  }

  // ---- カテゴリ ----
  function renderCats() {
    $('catRows').innerHTML = state.cats.map(function (c) {
      var n = state.users.filter(function (u) { return u.cats.indexOf(c.id) >= 0; }).length;
      return '<tr><td>' + esc(c.id) + '</td><td>' + esc(c.name) + '</td><td style="white-space:normal">' + esc(c.desc) + '</td><td>' + (c.folderId ? '設定済' : '<span class="hint">未設定</span>') + '</td><td>' + n + '</td>' +
        '<td class="row"><button class="small" data-act="edit" data-id="' + esc(c.id) + '">編集</button>' +
        '<button class="small danger" data-act="delete" data-id="' + esc(c.id) + '">削除</button></td></tr>';
    }).join('') || '<tr><td colspan="6" class="hint">カテゴリがありません</td></tr>';
  }

  $('catRows').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-act]');
    if (!b) return;
    var c = state.cats.filter(function (x) { return x.id === b.getAttribute('data-id'); })[0];
    if (!c) return;
    if (b.getAttribute('data-act') === 'edit') openCatDialog(c);
    else confirmBox('カテゴリ削除', '「' + c.name + '」を削除します。このカテゴリが付いている全員から外れます。', function () {
      call('apiDeleteCategory', [state.token, c.id], function () { loadAdmin(); });
    });
  });

  function openCatDialog(c) {
    state.editingCat = c;
    $('catDialogTitle').textContent = c ? 'カテゴリ編集' : 'カテゴリ追加';
    $('cName').value = c ? c.name : '';
    $('cDesc').value = c ? c.desc : '';
    $('cFolder').value = c && c.folderId ? 'https://drive.google.com/drive/folders/' + c.folderId : '';
    setMsg('catMsg', '');
    $('catDialog').classList.add('show');
  }

  function saveCat() {
    var c = state.editingCat;
    var data = { id: c ? c.id : '', name: $('cName').value.trim(), desc: $('cDesc').value.trim(), folder: $('cFolder').value.trim() };
    call('apiSaveCategory', [state.token, data, !c], function () {
      closeDialog('catDialog');
      loadAdmin(function () {
        call('apiMe', [state.token], function (res) { setMe(res.me); });
      });
    }, 'catMsg');
  }

  // ---- ファイル（見るだけ） ----
  var KIND_ICON = { folder: '📁', doc: 'DOC', sheet: 'XLS', slide: 'PPT', pdf: 'PDF', image: 'IMG', file: 'FILE', 'other-google': 'FILE' };
  var fileState = { catId: null, viewerUrl: null };

  $('myCats').addEventListener('click', function (e) {
    var el = e.target.closest('.cat.link');
    if (el) openFolder(el.getAttribute('data-cat'), null);
  });

  function openFolder(catId, folderId) {
    fileState.catId = catId;
    call('apiListFolder', [state.token, catId, folderId], function (res) {
      showView('files');
      $('crumbs').innerHTML = '<a data-home="1">ホーム</a>' + res.path.map(function (p, i) {
        return ' ＞ ' + (i === res.path.length - 1 ? '<b>' + esc(p.name) + '</b>' : '<a data-folder="' + esc(p.id) + '">' + esc(p.name) + '</a>');
      }).join('');
      var items = res.folders.map(function (f) {
        return '<li><span class="ic folder">📁</span><span class="nm folder" data-folder="' + esc(f.id) + '">' + esc(f.name) + '</span><span class="meta">' + esc(f.updated) + '</span></li>';
      }).concat(res.files.map(function (f) {
        var canOpen = f.kind !== 'other-google';
        return '<li><span class="ic ' + esc(f.kind === 'other-google' ? 'file' : f.kind) + '">' + esc(KIND_ICON[f.kind] || 'FILE') + '</span>' +
          '<span class="nm">' + esc(f.name) + '</span>' +
          '<span class="meta">' + esc(f.updated) + '</span>' +
          (canOpen ? '<button class="small" data-file="' + esc(f.id) + '" data-name="' + esc(f.name) + '">開く</button>' : '<span class="meta">開けません</span>') + '</li>';
      }));
      $('fileList').innerHTML = items.join('');
      $('filesEmpty').textContent = items.length ? '' : 'このフォルダは空です。';
    });
  }

  $('crumbs').addEventListener('click', function (e) {
    var a = e.target.closest('a');
    if (!a) return;
    if (a.getAttribute('data-home')) showView('home');
    else openFolder(fileState.catId, a.getAttribute('data-folder'));
  });

  $('fileList').addEventListener('click', function (e) {
    var f = e.target.closest('[data-folder]');
    if (f) { openFolder(fileState.catId, f.getAttribute('data-folder')); return; }
    var b = e.target.closest('button[data-file]');
    if (b) openFile(b.getAttribute('data-file'), b.getAttribute('data-name'));
  });

  function openFile(fileId, label) {
    call('apiGetFile', [state.token, fileState.catId, fileId], function (res) {
      var bin = atob(res.base64);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      if (fileState.viewerUrl) URL.revokeObjectURL(fileState.viewerUrl);
      var url = URL.createObjectURL(new Blob([bytes], { type: res.mimeType }));
      fileState.viewerUrl = url;
      $('viewerName').textContent = res.name;
      $('viewerDownload').href = url;
      $('viewerDownload').setAttribute('download', res.name);
      var body = $('viewerBody');
      if (res.mimeType === 'application/pdf') body.innerHTML = '<iframe src="' + url + '"></iframe>';
      else if (/^image\//.test(res.mimeType)) body.innerHTML = '<img src="' + url + '" alt="">';
      else body.innerHTML = '<p style="padding:20px">このファイルは画面に表示できません。「ダウンロード」から開いてください。</p>';
      $('viewerDialog').classList.add('show');
    });
  }

  function closeViewer() {
    closeDialog('viewerDialog');
    $('viewerBody').innerHTML = '';
    if (fileState.viewerUrl) { URL.revokeObjectURL(fileState.viewerUrl); fileState.viewerUrl = null; }
  }

  // ---- ログ ----
  function loadLog() {
    call('apiGetLog', [state.token, 200], function (res) {
      $('logRows').innerHTML = res.logs.map(function (l) {
        return '<tr><td>' + esc(l.at) + '</td><td>' + esc(l.by) + '</td><td>' + esc(l.action) + '</td><td>' + esc(l.target) + '</td><td style="white-space:normal">' + esc(l.detail) + '</td></tr>';
      }).join('') || '<tr><td colspan="5" class="hint">ログはまだありません</td></tr>';
    });
  }

  showView('login');
</script>
