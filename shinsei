<script>
(function () {
  var STATUS_CLASS = { '承認待ち': 'pending', '承認': 'approved', '差し戻し': 'returned', '却下': 'rejected' };
  var STAMP = { '承認': '承認', '差し戻し': '差戻', '却下': '却下' };
  var KINDS = { text: '短い文', textarea: '長い文', select: '選択', date: '日付', number: '数字' };
  var FIXED = { dept: 1, job: 1 };
  var WD = '日月火水木金土';
  var S = null;
  function fresh() {
    return { loaded: false, cfg: null, typeMap: {}, mine: [], all: [], tab: 'new', form: null, drafts: {}, open: null, confirm: null, busy: false,
      forms: null, formsDirty: false, editId: null, cats: [] };
  }
  S = fresh();

  // ---- ログインシステムの画面切替に「申請」を足す ----
  var origShowView = window.showView;
  window.showView = function (name) {
    var sec = $('view-shinsei');
    if (name === 'shinsei' && state.me && !state.me.mustChange) {
      origShowView('shinsei');          // 既存の画面をすべて隠す
      sec.classList.remove('hidden');
      openTab(S.tab);
      return;
    }
    sec.classList.add('hidden');
    origShowView(name);
    if (name === 'home' && state.me && !state.me.mustChange) renderHomeCard();
  };
  var origReset = window.resetToLogin;
  window.resetToLogin = function (message) {
    S = fresh();
    // 前の人の申請が画面の裏に残らないよう、申請画面の中身をすべて消す（共用PC対策）
    ['shForm', 'shEd', 'shMine', 'shPending', 'shAll', 'shSummary', 'shTypes', 'shDialogBody', 'shTabs'].forEach(function (id) { $(id).innerHTML = ''; });
    $('shFltQ').value = ''; $('shFltType').value = ''; $('shFltStatus').value = '';
    $('shForm').classList.add('hidden'); $('shPick').classList.remove('hidden');
    var hc = $('shHomeCard'); if (hc) hc.remove();
    origReset(message);
  };

  // ヘッダーに「申請」ボタン
  (function () {
    var homeBtn = document.querySelector('#appHeader .row button');
    var b = document.createElement('button');
    b.className = 'small';
    b.textContent = '申請';
    b.addEventListener('click', function () { showView('shinsei'); });
    homeBtn.parentNode.insertBefore(b, homeBtn.nextSibling);
  })();

  // ホームの「申請・届出」カード
  function renderHomeCard() {
    var card = $('shHomeCard');
    if (!card) {
      card = document.createElement('div');
      card.className = 'card';
      card.id = 'shHomeCard';
      var home = $('view-home');
      home.insertBefore(card, home.firstChild);
    }
    var admin = state.me.role === ROLE_ADMIN;
    card.innerHTML = '<div class="sh-homecard"><div class="sh-kanji">申</div><div class="sh-mid"><b>申請・届出</b><br><span class="hint">' +
      (admin ? '休暇申請・出張報告などの提出と、届いた申請の承認' : '休暇申請・出張報告などをこの画面から提出できます') +
      '</span></div><span id="shHomeBadge"></span><button class="primary" id="shHomeOpen">申請画面を開く</button></div>';
    $('shHomeOpen').addEventListener('click', function () { showView('shinsei'); });
    if (admin) {
      google.script.run.withSuccessHandler(function (res) {
        if (res && res.ok && res.pending && $('shHomeBadge')) $('shHomeBadge').innerHTML = '<span class="sh-st pending">承認待ち ' + res.pending + '件</span>';
      }).apiShinseiCount(state.token);
    }
  }

  // ---- サーバー呼び出し ----
  /** call() と同じだが、失敗したときに onErr(メッセージ) を呼ぶ */
  function run(fn, args, onOk, onErr) {
    $('loading').style.display = 'block';
    var r = google.script.run
      .withSuccessHandler(function (res) {
        $('loading').style.display = 'none';
        if (res && res.ok) { onOk(res); return; }
        if (res && res.relogin) { resetToLogin(res.message); return; }
        onErr((res && res.message) || 'エラーが発生しました');
      })
      .withFailureHandler(function () {
        $('loading').style.display = 'none';
        onErr('通信エラーが発生しました。もう一度お試しください。');
      });
    r[fn].apply(r, args);
  }
  function load(withConfig, cb) {
    call('apiShinseiData', [state.token, !!withConfig], function (res) {
      if (res.config) {
        S.cfg = res.config;
        S.typeMap = {};
        res.config.types.forEach(function (t) { S.typeMap[t.id] = t; });
        renderTypes();
        if (S.form && !S.typeMap[S.form.type] && S.form.step !== 'done') closeForm();
      }
      S.mine = sortRecs(res.mine || []);
      S.all = sortRecs(res.all || []);
      S.loaded = true;
      renderTabs(); renderLists();
      if (S.open) renderDialog();
      if (cb) cb();
    });
  }
  function sortRecs(a) { return a.sort(function (x, y) { return y.sortKey - x.sortKey; }); }
  function isAdmin() { return !!(S.cfg && S.cfg.isApprover); }
  function pendingRecs() { return S.all.filter(function (r) { return r.status === '承認待ち'; }).reverse(); }

  // ---- タブ ----
  function tabDefs() {
    var t = [['new', '新規申請'], ['mine', '自分の申請']];
    if (isAdmin()) t.push(['pending', '承認待ち'], ['all', '全申請'], ['forms', '様式の設定']);
    return t;
  }
  function renderTabs() {
    var n = isAdmin() ? pendingRecs().length : 0;
    $('shTabs').innerHTML = tabDefs().map(function (t) {
      return '<button data-tab="' + t[0] + '" class="' + (S.tab === t[0] ? 'active' : '') + '">' + t[1] +
        (t[0] === 'pending' && n ? '<span class="sh-n">' + n + '</span>' : '') +
        (t[0] === 'forms' && S.formsDirty ? '<span class="sh-n">未保存</span>' : '') + '</button>';
    }).join('');
  }
  function openTab(name) {
    if (!S.loaded) { S.tab = name; load(true, function () { openTab(S.tab); }); return; }
    if (!tabDefs().some(function (t) { return t[0] === name; })) name = 'new';
    S.tab = name;
    ['new', 'mine', 'pending', 'all', 'forms'].forEach(function (k) { $('shPane-' + k).classList.toggle('hidden', k !== name); });
    renderTabs(); renderLists();
    if (name === 'forms') { if (S.forms) renderEditor(); else loadForms(); }
  }
  $('shTabs').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-tab]');
    if (!b) return;
    var t = b.getAttribute('data-tab');
    if (t === 'new') load(true, function () { openTab(t); });
    else if (t === 'forms') openTab(t);
    else load(false, function () { openTab(t); });
  });
  $('shReload').addEventListener('click', function () { load(true); });

  // ---- 共通の表示 ----
  function pad(n) { return ('0' + n).slice(-2); }
  function fmtDate(v) {
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || '');
    if (!m) return v;
    var d = new Date(+m[1], m[2] - 1, +m[3]);
    return m[1] + '/' + m[2] + '/' + m[3] + '（' + WD.charAt(d.getDay()) + '）';
  }
  function dayCount(a, b) {
    if (!a || !b) return null;
    var n = Math.round((new Date(b) - new Date(a)) / 864e5) + 1;
    return n > 0 ? n : null;
  }
  function showVal(f, v) {
    if (v === '' || v == null) return '—';
    if (f.type === 'date') return fmtDate(v);
    if (f.type === 'number') return Number(v).toLocaleString('ja-JP') + ' 円';
    return v;
  }
  function rowsHTML(defs, vals, range) {
    vals = vals || {};
    var h = defs.map(function (f) { return '<dt>' + esc(f.label) + '</dt><dd>' + esc(showVal(f, vals[f.k])) + '</dd>'; }).join('');
    if (range) { var n = dayCount(vals[range[0]], vals[range[1]]); if (n) h += '<dt>日数</dt><dd>' + n + '日間</dd>'; }
    return h;
  }
  function remember(v) {
    var key = 'shinsei_me_' + (S.cfg ? S.cfg.myId : '');
    try {
      if (v) { localStorage.setItem(key, JSON.stringify(v)); return v; }
      return JSON.parse(localStorage.getItem(key) || 'null');
    } catch (e) { return null; }
  }

  // ---- 新規申請 ----
  function renderTypes() {
    var types = S.cfg.types;
    var html = types.map(function (t) {
      return '<button class="cat link" data-type="' + esc(t.id) + '"><span class="sh-kanji">' + esc(t.ch) + '</span><span><b>' + esc(t.label) +
        '</b><span class="hint">' + esc(t.desc) + '</span></span></button>';
    }).join('');
    var url = S.cfg.hiyariUrl;
    html += url
      ? '<a class="cat link sh-hiyari" style="display:flex;gap:12px;text-decoration:none;color:inherit" target="_blank" rel="noopener" id="shHiyari" href="#"><span class="sh-kanji">ヒ</span><span><b>ヒヤリハット・事故報告</b><span class="hint">報告用のシステムが別の画面で開きます</span></span></a>'
      : '<div class="cat sh-hiyari" style="display:flex;gap:12px"><span class="sh-kanji">ヒ</span><span><b>ヒヤリハット・事故報告</b><span class="hint">報告先を準備中です。これまでどおり報告用紙に記入してください。</span></span></div>';
    $('shTypes').innerHTML = (types.length ? '' : '<p class="hint" style="grid-column:1/-1">いま受け付けている申請はありません。</p>') + html;
  }
  function hiyariHref() {
    var mem = remember() || {};
    var d = new Date();
    var today = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    var map = { name: S.cfg.myName, dept: mem.dept || '', job: mem.job || '', date: today };
    return S.cfg.hiyariUrl.replace(/\{(name|dept|job|date)\}/g, function (_, k) { return encodeURIComponent(map[k]); });
  }
  $('shTypes').addEventListener('click', function (e) {
    var h = e.target.closest('#shHiyari');
